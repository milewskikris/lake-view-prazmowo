# Publiczny adres produkcyjny strony (bez ukośnika na końcu).
# Używany w metadanych, Open Graph, sitemap.xml i robots.txt.
# Na Vercel można go pominąć – wtedy używany jest VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://twoja-domena.pl

# --- Wysyłka zapytań z formularza (Resend, https://resend.com) ---
# Klucz API Resend. SEKRET – ustaw tylko w Vercel → Settings → Environment Variables.
RESEND_API_KEY=
# Nadawca wiadomości – adres w domenie zweryfikowanej w Resend, np. "Lake View Prażmowo <formularz@twojadomena.pl>".
CONTACT_FROM_EMAIL=
# Odbiorca zapytań (biuro sprzedaży). Kilka adresów oddziel przecinkami.
CONTACT_TO_EMAIL=
